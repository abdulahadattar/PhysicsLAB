firestore
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for the 'grades' collection
    match /grades/{gradeId} { 
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.teacher == true;
    }

    // Rules for the 'chapters' collection
    match /chapters/{chapterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.teacher == true;
    }

    // Rules for the 'studyMaterials' collection
    match /studyMaterials/{chapterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.teacher == true;
      
      // Rules for the 'pdfResources' subcollection under studyMaterials
      match /pdfResources/{pdfResourceId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.teacher == true;
      }
    }

    // Rules for the 'quizzes' collection
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.teacher == true;
    }

    // Rules for the 'questions' collection
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.teacher == true;
    }

    // Rules for the 'quizAttempts' collection
    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null && (request.auth.token.teacher == true || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false; // Attempts should not be updated after creation
      allow delete: if false; // Attempts should not be deleted
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow write: if request.auth != null && request.auth.token.teacher == true;
      allow read: if request.auth != null; // Assuming authenticated users can read all files
    }
  }
}